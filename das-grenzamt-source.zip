, доносился ли он из леса или из остановившегося пассажирского состава."]},col2:{rubric:"ИСПРАВЛЕНИЕ В СЛУЖЕБНОЙ СВОДКЕ",title:"Гладкая кожа не исключает Werwolf",caption:"Утренний осмотр на посту: решают несколько признаков, а не один.",paragraphs:["На соседнем посту задержан Werwolf с полностью выбритыми руками. Кожу он тщательно обработал лезвием. Выдали его не волосы, а острые когти и жёлтые глаза с вертикальным зрачком.","Отдельно установлено, что у Nachzehrer также могут быть волосы и щетина на теле. В разговоре задержанные ссылались на наследственность, холод и отсутствие средств гигиены."]},col3:{rubric:"ДОПОЛНЕНИЕ К ОПРЕДЕЛИТЕЛЮ",title:"Ночь 3: задавайте вопросы и сопоставляйте признаки",paragraphs:["Клеркам поручено не принимать решений только по количеству волос. Один и тот же внешний признак встречается у разных прибывающих."],directiveTitle:"ПОРЯДОК ПРОВЕРКИ НА ТРЕТЬЮ НОЧЬ:",directiveItems:["Волосы, щетина и гладкая кожа возможны у людей, Nachzehrer и Werwolf.","В разделе «Кожа» можно спросить, почему волосы такие длинные или недавно сбриты.","Ответ — лишь объяснение. Проверьте глаза, форму ногтей, грязь и другие признаки.","Очки и перчатки всё ещё требуется снимать перед осмотром."]},buttonLabel:"ОТЛОЖИТЬ ГАЗЕТУ · НАЧАТЬ ТРЕТЬЮ НОЧЬ"};function $y(){return t.jsxs("svg",{viewBox:"0 0 220 96",className:"newspaper-woodcut__svg","aria-hidden":"true",children:[t.jsx("rect",{width:"220",height:"96",fill:"#c6ae83"}),t.jsx("rect",{x:"4",y:"4",width:"212",height:"88",fill:"#342314"}),t.jsx("path",{d:"M13 86 C15 64 18 45 27 29 L75 25 C92 28 94 46 90 64 L91 86 Z",fill:"#c6ae83",stroke:"#e0cca2",strokeWidth:"1"}),Array.from({length:22},(s,e)=>{const n=25+e*13%54,c=34+e*19%40;return t.jsx("path",{d:`M${n} ${c} q-2 7 1 11`,fill:"none",stroke:"#342314",strokeWidth:"1"},e)}),t.jsx("path",{d:"M116 86 L120 25 L155 20 C174 20 183 34 183 50 L185 86 Z",fill:"#c6ae83"}),Array.from({length:12},(s,e)=>t.jsx("path",{d:`M${132+e%4*12} ${36+Math.floor(e/4)*13} l1 3`,stroke:"#342314",strokeWidth:"1.6"},e)),t.jsxs("g",{transform:"translate(134 63) rotate(-18)",children:[t.jsx("rect",{x:"0",y:"0",width:"53",height:"9",rx:"4",fill:"#20150c",stroke:"#e0cca2",strokeWidth:"0.7"}),t.jsx("path",{d:"M4 0 L19 -35 L38 -38 L24 -3 Z",fill:"#e1cea6",stroke:"#20150c",strokeWidth:"1"}),t.jsx("path",{d:"M8 -1 L23 -34",stroke:"#705639",strokeWidth:"1"}),t.jsx("circle",{cx:"8",cy:"4",r:"1.5",fill:"#c6ae83"})]}),t.jsx("path",{d:"M103 13 L103 86",stroke:"#c6ae83",strokeWidth:"1",strokeDasharray:"3 3"}),t.jsx("rect",{x:"2",y:"2",width:"216",height:"92",fill:"none",stroke:"#332212",strokeWidth:"1.5"})]})}const yy={day:4,issueNumber:"ВЫПУСК № 288 · ЧРЕЗВЫЧАЙНЫЙ ВЫПУСК",dateLabel:"ПЯТНИЦА, 15 ОКТЯБРЯ 1943 Г. · ЧЕТВЁРТАЯ НОЧЬ",weatherLabel:"МОРОЗНЫЙ ТУМАН, ГОЛОЛЁД · −5°C",priceLabel:"СЛУЖЕБНЫЙ ЭКЗЕМПЛЯР СД",shiftBanner:"ТРЕТЬЯ НОЧЬ ЗАВЕРШЕНА · СТЕКЛО РАСКРЫВАЕТ МЁРТВЫХ",mainHeadline:"ХОЛОДНЫЙ ВЫДОХ: ЖИВОЕ ТЕПЛО И ТРУПНЫЙ ЛЁД",mainDeck:"Комендатура вводит пробу дыхания на стекле. Твари дышат ледяной пустотой или исходят болотной сыростью.",col1:{rubric:"ФРОНТОВОЙ РЕПОРТАЖ",title:"«Мы бьёмся не только с людьми»: леденящие кровь вести с передовой",dropCap:"Н",lead:"очной курьер фельджандармерии доставил в штаб измятый пакет, залитый замёрзшей кровью. На восточных болотах целые роты пропадают во мгле без звука выстрела.",paragraphs:["— Они подползают в солдатских шинелях, с документами погибших товарищей, — дрожащей рукой пишет капитан фон Берг перед тем, как связь оборвалась. — Они говорят на нашем языке, показывают пропуска, но изо рта их не идёт пар на морозе!","На товарной станции Остмарка обер-лейтенант лично застрелил двух санитаров: при минус пяти градусах от их ртов не было даже тончайшей струйки пара. Пули отскочили от рёбер с глухим хрустом."]},col2:{rubric:"КОШМАР НА КПП OSTMARK-2",title:"«Оно дыхнуло — и стекло покрылось мутной речной слизью»",caption:"Проба выдоха: матовый пар живых, ледяная тишина нежити или болотные капли.",paragraphs:["Вчера в два часа ночи на соседнем посту женщина в дорогой вуали улыбнулась клерку и по его просьбе прижалась губами к решётке. Стекло запотело, но тут же потекло тяжёлыми водянистыми каплями с запахом гнилых водорослей.","Когда дежурный поднял карабин, «дама» с визгом распорола пальцами сетку и бросилась в ледяную реку. С тех пор введено правило: требовать выдох строго на расстоянии ладони!"]},col3:{rubric:"СЕКРЕТНАЯ ДИРЕКТИВА СД",title:"«Мёртвые не согреют стекла»: инструкция к четвёртой ночи",paragraphs:["Blutsauger и Nachzehrer не имеют внутреннего тепла. Их выдох сух и мёртв — стекло остаётся кристально прозрачным. Но помните: испуганный или истощённый человек тоже может выдохнуть слабо."],directiveTitle:"СТРОГИЙ ПРИКАЗ КЛЕРКУ НА НОЧЬ 4:",directiveItems:["Потребуйте: «Дыхните на стекло, пожалуйста». Смотрите на матовый круг.","Сухое стекло — повод для максимальной бдительности, но не спешите стрелять без других улик.","Солёные капли и белёсый налёт — след морской нежити. Ногти, зубы и глаза перепроверяйте вдвойне!","Если человек упирается и стыдится — объясните приказ. Нелюдь откажется наотрез или зарычит."]},buttonLabel:"ЗАСТУПИТЬ НА ЧЕТВЁРТУЮ НОЧЬ"};function by(){return t.jsxs("svg",{viewBox:"0 0 220 96",className:"newspaper-woodcut__svg","aria-hidden":"true",children:[t.jsx("rect",{width:"220",height:"96",fill:"#c8b18a"}),t.jsx("rect",{x:"7",y:"8",width:"206",height:"80",fill:"#342517"}),[14,82,150].map((s,e)=>t.jsxs("g",{children:[t.jsx("rect",{x:s,y:"15",width:"57",height:"64",fill:"#756951",stroke:"#d2bd96",strokeWidth:"2"}),t.jsx("path",{d:`M${s+8} 18 l-5 50 M${s+19} 18 l-8 55`,stroke:"#c8b18a",opacity:"0.22",strokeWidth:"2"}),e!==2&&t.jsx("ellipse",{cx:s+29,cy:"47",rx:"21",ry:"17",fill:"#d0bb95",opacity:"0.6"}),e===1&&[0,1,2,3,4].map(n=>t.jsx("path",{d:`M${s+15+n*7} ${31+n%2*10} q-5 10 0 12 q5 -2 0 -12`,fill:"#413523",stroke:"#e3cda7",strokeWidth:"0.75"},n)),t.jsx("path",{d:`M${s+7} 83 h43`,stroke:"#d2bd96",strokeWidth:"0.9"})]},s)),t.jsx("rect",{x:"2",y:"2",width:"216",height:"92",fill:"none",stroke:"#342517",strokeWidth:"1.5"})]})}const ky={day:5,issueNumber:"ВЫПУСК № 289 · ОСОБЫЙ СЕКРЕТНЫЙ ЦИРКУЛЯР",dateLabel:"СУББОТА, 16 ОКТЯБРЯ 1943 Г. · ПЯТАЯ НОЧЬ",weatherLabel:"ШТОРМОВОЙ ВЕТЕР, МЕТЕЛЬ · −8°C",priceLabel:"ТОЛЬКО ДЛЯ ОФИЦЕРОВ СД",shiftBanner:"ЧЕТВЁРТАЯ НОЧЬ ПРЕОДОЛЕНА · В ГОРОД ПРОНИКАЮТ ДВОЙНИКИ",mainHeadline:"DOPPELGÄNGER: ОНИ СТАНОВЯТСЯ НАМИ",mainDeck:"Служба Безопасности признала существование идеальных подражателей. Теперь каждый вызов ликвидатора требует письменного обоснования.",col1:{rubric:"ДОНЕСЕНИЕ ИЗ БЕРЛИНА",title:"«Они крадут лица наших родных»: доклад имперского комиссара",dropCap:"Н",lead:"а высшем совещании безопасности оглашён закрытый меморандум. В городах обнаружены существа нового типа — Doppelgänger (Двойники).",paragraphs:["Они не боятся солнечного света, не просят воды и умеют имитировать человеческую речь. Их кожа безупречно гладкая: на теле нет ни волоска, ни щетинки.","Но главное отличие скрыто от поверхностного взгляда: склеры их глаз всегда остаются чистыми, молочно-белыми. При этом люди, Werwolf и Nachzehrer от бессонных ночей, пороховой гари и ярости часто имеют красные, воспалённые белки глаз.","Копирование голоса даёт сбой в половине случаев. Мужская внешность может сочетаться с женским тембром, а женская с мужским. Сверяйте голос с полом в паспорте и проверяйте другие признаки."]},col2:{rubric:"АНАТОМИЯ МОНСТРА",title:"Вторая глотка в глубине рта: анатомический эскиз",caption:"Рис. 3. Слева: человеческий облик двойника. Справа: обычные зубы (1) и скрытая вторая челюсть (2).",paragraphs:["При вскрытии ликвидированного на вокзале Двойника патологоанатом обнаружил страшную деталь: сразу за нормальным зубным рядом, в глубине зева, прячется вторая хищная челюсть с мелкими бритвенными зубами.","Заставьте посетителя открыть рот как можно шире и вглядитесь в тёмную глубину за языком. Если там сверкнут вторые зубы — перед вами тварь без души."]},col3:{rubric:"ПРИКАЗ № 1943-SD/5",title:"Новый порядок вызова СД: протокол обоснования",paragraphs:["Слишком много пуль потрачено на ложные тревоги. С пятой ночи дежурный офицер СД стреляет только после того, как клерк назовёт точные улики преступления."],directiveTitle:"ПРАВИЛА НА ПЯТУЮ НОЧЬ:",directiveItems:["При нажатии кнопки «СД / ОГОНЬ» укажите конкретные улики (вторая челюсть, отсутствие седины, клыки и др.).","Вы можете расспрашивать людей о красных белках глаз и разрезе глаз.","У Двойников никогда не бывает красных белков и никогда нет волос на теле.","Человек с красными глазами может быть просто больным или уставшим."]},buttonLabel:"ЗАСТУПИТЬ НА ПЯТУЮ НОЧЬ"},yt="#2c1e10",K0="#342314",V1="#6b5135",jy="#cbb58b",Jc="#e0cca2",My="#ded2b8",J0="#fbf5e6";function Cy(){const s=`doppel-plate-${B.useId().replace(/[^a-zA-Z0-9_-]/g,"")}`,e="M83 16 C52 16 38 40 40 75 C39 106 46 127 62 140 Q83 153 104 140 C120 127 127 106 126 75 C128 40 114 16 83 16 Z";return t.jsxs("svg",{viewBox:"0 0 440 260",className:"newspaper-woodcut__svg",role:"img","aria-label":"Гравюра: человеческий облик двойника слева, обычные зубы и скрытая вторая челюсть справа",children:[t.jsxs("defs",{children:[t.jsx("pattern",{id:`${s}-hatch`,width:"5",height:"5",patternUnits:"userSpaceOnUse",patternTransform:"rotate(35)",children:t.jsx("path",{d:"M0 0 V5",stroke:V1,strokeWidth:"0.8"})}),t.jsx("clipPath",{id:`${s}-face`,children:t.jsx("path",{d:e})})]}),t.jsx("rect",{width:"440",height:"260",fill:jy}),t.jsx("rect",{x:"4",y:"4",width:"432",height:"252",fill:"none",stroke:yt,strokeWidth:"2"}),t.jsx("rect",{x:"8",y:"8",width:"424",height:"244",fill:"none",stroke:V1,strokeWidth:"0.8"}),t.jsxs("g",{stroke:yt,fill:"none",children:[t.jsx("path",{d:"M20 35 H420 M20 226 H420",strokeWidth:"1.3"}),t.jsx("path",{d:"M202 45 V215",strokeWidth:"0.8",strokeDasharray:"3 4"})]}),t.jsx("text",{x:"220",y:"26",textAnchor:"middle",fill:yt,fontFamily:"Georgia, serif",fontSize:"14",fontWeight:"700",letterSpacing:"2",children:"DOPPELGANGER · V"}),t.jsxs("g",{transform:"translate(18 43)",children:[t.jsx("ellipse",{cx:"83",cy:"88",rx:"72",ry:"80",fill:`url(#${s}-hatch)`,opacity:"0.16"}),t.jsx("path",{d:"M10 177 C18 155 38 151 59 145 L83 161 L106 145 C127 151 148 157 157 177 Z",fill:K0,stroke:yt,strokeWidth:"1.5"}),t.jsx("path",{d:"M19 173 L50 154 M30 174 L59 155 M137 173 L110 155 M147 174 L116 154",stroke:Jc,strokeWidth:"1"}),t.jsx("path",{d:"M64 132 L61 153 L83 168 L105 153 L102 132 Z",fill:"#cfc0a0",stroke:yt,strokeWidth:"1.4"}),t.jsx("path",{d:"M61 151 L83 163 L70 178 L48 157 Z M105 151 L83 163 L97 178 L119 157 Z",fill:Jc,stroke:yt,strokeWidth:"1.4"}),t.jsx("path",{d:"M79 165 L87 165 L90 179 H76 Z",fill:yt}),t.jsx("path",{d:"M41 73 C28 67 26 79 31 95 Q35 108 43 102 Z M125 73 C138 67 141 79 136 95 Q132 108 124 102 Z",fill:"#d8c8a4",stroke:yt,strokeWidth:"1.4"}),t.jsx("path",{d:"M35 79 Q29 83 37 97 M131 79 Q138 83 129 97",fill:"none",stroke:V1,strokeWidth:"1"}),t.jsx("path",{d:e,fill:"#e3d3b1",stroke:yt,strokeWidth:"1.8"}),t.jsxs("g",{clipPath:`url(#${s}-face)`,children:[t.jsx("path",{d:"M109 45 Q130 82 112 121 L97 141 L117 140 L136 71 Z",fill:`url(#${s}-hatch)`,opacity:"0.5"}),t.jsx("path",{d:"M44 82 Q44 108 61 132 Q48 111 54 92 Z",fill:"#b7a37e"}),t.jsx("path",{d:"M56 111 L67 121 M54 117 L64 127 M53 124 L61 132",fill:"none",stroke:V1,strokeWidth:"0.8"})]}),t.jsx("path",{d:"M39 70 C34 31 51 10 82 10 C112 5 135 27 128 68 L119 49 C103 40 85 43 72 51 Q53 48 44 70 Z",fill:yt,stroke:yt,strokeWidth:"1.5"}),t.jsxs("g",{fill:"none",stroke:Jc,strokeWidth:"0.9",strokeLinecap:"round",children:[t.jsx("path",{d:"M48 48 Q54 26 76 20 M53 44 Q60 26 82 18 M62 42 Q77 25 102 25 M74 40 Q94 29 116 38 M87 40 Q107 33 124 48"}),t.jsx("path",{d:"M72 48 Q73 34 84 15",strokeWidth:"1.3"})]}),t.jsx("path",{d:"M48 66 Q61 61 73 66 M94 66 Q105 60 118 66",fill:"none",stroke:yt,strokeWidth:"2.6",strokeLinecap:"round"}),[61,105].map(n=>t.jsxs("g",{children:[t.jsx("path",{d:`M${n-12} 77 Q${n} 68 ${n+12} 77 Q${n} 84 ${n-12} 77 Z`,fill:J0,stroke:yt,strokeWidth:"1.25"}),t.jsx("circle",{cx:n,cy:"76.5",r:"3.8",fill:"#9a8a6c",stroke:yt,strokeWidth:"0.8"}),t.jsx("circle",{cx:n,cy:"76.5",r:"1.7",fill:yt}),t.jsx("path",{d:`M${n-11} 85 Q${n} 89 ${n+9} 85`,fill:"none",stroke:V1,strokeWidth:"0.7"})]},n)),t.jsx("path",{d:"M81 80 Q80 96 74 106 Q79 112 84 110 Q92 112 96 106 M78 108 L80 108 M88 108 L91 108",fill:"none",stroke:yt,strokeWidth:"1.2",strokeLinecap:"round"}),t.jsx("path",{d:"M69 124 Q76 119 83 122 Q90 119 98 124 Q83 127 69 124 Z",fill:"#b59672",stroke:"#5b4326",strokeWidth:"0.9"}),t.jsx("path",{d:"M70 125 Q83 134 97 125 M76 137 Q83 140 91 137",fill:"none",stroke:V1,strokeWidth:"0.9"})]}),t.jsxs("g",{transform:"translate(217 43)",children:[t.jsx("path",{d:"M6 98 C36 42 168 42 198 98 C168 169 36 169 6 98 Z",fill:"#cbb98f",stroke:yt,strokeWidth:"2"}),t.jsx("path",{d:"M16 98 C43 61 161 61 188 98 C161 145 43 145 16 98 Z",fill:K0}),t.jsx("path",{d:"M27 77 Q102 53 177 77 L168 90 Q102 78 36 90 Z M29 124 Q102 141 175 124 L164 143 Q102 153 40 143 Z",fill:"#8a7458"}),Array.from({length:8},(n,c)=>{const i=37+c*16.5,h=67+Math.abs(c-3.5)*1.3;return t.jsx("path",{d:`M${i} ${h} Q${i+7} ${h-3} ${i+14} ${h} L${i+13} ${h+20} Q${i+7} ${h+24} ${i+1} ${h+20} Z`,fill:My,stroke:yt,strokeWidth:"0.8"},`outer-upper-${c}`)}),Array.from({length:8},(n,c)=>{const i=40+c*16,h=120+Math.abs(c-3.5)*.9;return t.jsx("path",{d:`M${i} 139 L${i+1} ${h+3} Q${i+7} ${h-1} ${i+13} ${h+3} L${i+14} 139 Z`,fill:"#e6dcc2",stroke:yt,strokeWidth:"0.8"},`outer-lower-${c}`)}),t.jsx("ellipse",{cx:"102",cy:"104",rx:"45",ry:"16",fill:"#7d6a4e",stroke:Jc,strokeWidth:"1.1"}),t.jsx("ellipse",{cx:"102",cy:"104",rx:"41",ry:"12.5",fill:K0}),Array.from({length:9},(n,c)=>{const i=66+c*8;return t.jsx("path",{d:`M${i} 94 L${i+5} 94 L${i+2.5} 105 Z`,fill:J0,stroke:yt,strokeWidth:"0.55"},`inner-upper-${c}`)}),Array.from({length:8},(n,c)=>{const i=70+c*8;return t.jsx("path",{d:`M${i} 115 L${i+5} 115 L${i+2.5} 104 Z`,fill:J0,stroke:yt,strokeWidth:"0.55"},`inner-lower-${c}`)}),t.jsxs("g",{fill:"none",stroke:yt,strokeWidth:"0.9",children:[t.jsx("path",{d:"M92 69 L111 42 H180 M140 104 L166 163 H180"}),t.jsx("path",{d:"M26 116 l-7 9 M33 124 l-6 9 M170 125 l6 9 M177 117 l8 9"})]}),t.jsxs("g",{fontFamily:"Georgia, serif",fontSize:"11",fill:yt,textAnchor:"middle",children:[t.jsx("text",{x:"188",y:"46",children:"1"}),t.jsx("text",{x:"188",y:"167",children:"2"})]})]}),t.jsxs("g",{fontFamily:"Georgia, serif",fontSize:"12",fontWeight:"700",fill:yt,textAnchor:"middle",letterSpacing:"0.5",children:[t.jsx("text",{x:"101",y:"242",children:"I. ОБЛИК"}),t.jsx("text",{x:"320",y:"242",children:"II. ДВА РЯДА"})]})]})}const wy={day:6,issueNumber:"ВЫПУСК № 290 · СТРОГО СЕКРЕТНЫЙ ПРИКАЗ СД",dateLabel:"ВОСКРЕСЕНЬЕ, 17 ОКТЯБРЯ 1943 Г. · ШЕСТАЯ НОЧЬ",weatherLabel:"ШКВАЛИСТЫЙ БУРАН · −12°C",priceLabel:"ЛИЧНЫЙ ЭКЗЕМПЛЯР ОФИЦЕРА СД",shiftBanner:"ПЯТАЯ НОЧЬ ПОЗАДИ · НОВЫЕ ПРАВИЛА ДОСМОТРА",mainHeadline:"ЛУЧ СВЕТА В ГЛАЗА: ЗРАЧОК НЕ ЛЖЁТ",mainDeck:"Комендатура вводит досмотровые фонарики и предупреждает об анатомических сбоях у Двойников: шестипалости и расщеплении зрачков.",col1:{rubric:"ЗАКРЫТЫЙ ОТЧЁТ СД",title:"«Их зрачки мертвы к свету»: открытие полевого госпиталя",dropCap:"Ш",lead:"табные медики выявили критическую слабость Двойников. При направлении яркого луча в глаз их зрачки не реагируют и остаются застывшими.",paragraphs:["У человека, Blutsauger, Werwolf и Nachzehrer зрачок мгновенно сужается от вспышки света — это естественный рефлекс живого или полуживого глаза.","У Двойников же глазная сфера — искусственная имитация. Их зрачок не расширяется и не сужается, сохраняя стеклянный, мёртвый диаметр."]},col2:{rubric:"АНАТОМИЧЕСКИЙ БЮЛЛЕТЕНЬ",title:"Сбои мимикрии: 6 пальцев и двойные зрачки",caption:"Рис. 4. Проба светом: обычный зрачок сужается, а зрачок двойника остаётся неподвижным.",paragraphs:["В панике перед закрытием границы Двойники торопятся с копированием тел. Примерно у четверти тварей происходят грубые морфологические сбои.","Осматривайте руки и перчатки: у них может быть шестой палец (полидактилия). В глазах при снятых очках иногда заметны два зрачка в одной радужке (поликория)."]},col3:{rubric:"ПРИКАЗ КОМЕНДАНТА НА НОЧЬ 6",title:"Инструкция к шестой ночи",paragraphs:["Ночное дежурство продолжается. На пост Ostmark-3 поступили досмотровые фонарики. Проверку реакции зрачков добавляют к осмотру документов, зубов и рук."],directiveTitle:"ОБЯЗАТЕЛЬНО К ИСПОЛНЕНИЮ (НОЧЬ 6):",directiveItems:["При осмотре глаз включите фонарик: проверьте, сужается ли зрачок от света.","Считайте пальцы: лишний (шестой) палец на кисти или перчатке — явная улика.","Двойные зрачки (поликория) подтверждают мутацию чудовища.","Вторая челюсть, отсутствие седины и гладкая кожа остаются в силе."]},buttonLabel:"ЗАСТУПИТЬ НА ШЕСТУЮ НОЧЬ"},qa="#2c1e10",Ly="#342517",X1="#6b5135",vy="#c8b18a",gy="#d2bd96",H4="#f0e4c8";function Sy(){const s=`light-plate-${B.useId().replace(/[^a-zA-Z0-9_-]/g,"")}`;return t.jsxs("svg",{viewBox:"0 0 440 256",className:"newspaper-woodcut__svg",role:"img","aria-label":"Гравюра: фонарик освещает два глаза. Обычный зрачок сужается, зрачок двойника не меняется",children:[t.jsx("defs",{children:t.jsx("pattern",{id:`${s}-hatch`,width:"6",height:"6",patternUnits:"userSpaceOnUse",patternTransform:"rotate(35)",children:t.jsx("path",{d:"M0 0 V6",stroke:X1,strokeWidth:"0.8"})})}),t.jsx("rect",{width:"440",height:"256",fill:vy}),t.jsx("rect",{x:"4",y:"4",width:"432",height:"248",fill:"none",stroke:qa,strokeWidth:"2"}),t.jsx("rect",{x:"8",y:"8",width:"424",height:"240",fill:"none",stroke:X1,strokeWidth:"0.8"}),t.jsx("text",{x:"220",y:"26",fontFamily:"Georgia, serif",fontSize:"14",fontWeight:"700",letterSpacing:"2",textAnchor:"middle",fill:qa,children:"ПРОБА СВЕТОМ · VI"}),t.jsx("path",{d:"M20 35 H420",fill:"none",stroke:qa,strokeWidth:"1.3"}),t.jsx("path",{d:"M98 116 L284 47 L284 108 Z M98 132 L284 148 L284 208 Z",fill:`url(#${s}-hatch)`,opacity:"0.3"}),t.jsxs("g",{fill:"none",stroke:X1,strokeWidth:"1",children:[t.jsx("path",{d:"M98 116 L274 54 M98 116 L274 105 M98 132 L274 151 M98 132 L274 203"}),t.jsx("path",{d:"M102 123 L273 79 M102 125 L273 177",strokeDasharray:"4 4"})]}),t.jsxs("g",{transform:"translate(21 106)",children:[t.jsx("rect",{x:"0",y:"5",width:"49",height:"28",rx:"3",fill:"#4a3f31",stroke:qa,strokeWidth:"1.8"}),t.jsx("path",{d:"M49 5 L67 0 L77 3 V35 L67 39 L49 33 Z",fill:"#a8926e",stroke:qa,strokeWidth:"1.8"}),t.jsx("ellipse",{cx:"76",cy:"19",rx:"5",ry:"15",fill:H4,stroke:qa,strokeWidth:"1.5"}),t.jsx("rect",{x:"19",y:"1",width:"13",height:"5",rx:"1",fill:qa}),t.jsx("g",{stroke:gy,strokeWidth:"0.9",children:[9,15,21,27,33,39].map(e=>t.jsx("path",{d:`M${e} 9 V29`},e))}),t.jsx("path",{d:"M51 10 L66 5 M51 17 H68 M51 24 L66 29",fill:"none",stroke:X1,strokeWidth:"0.9"})]}),[{y:79,radius:7,label:"РЕАКЦИЯ ЕСТЬ"},{y:178,radius:18,label:"РЕАКЦИИ НЕТ"}].map(({y:e,radius:n,label:c})=>t.jsxs("g",{children:[t.jsx("path",{d:`M255 ${e} C282 ${e-35} 365 ${e-35} 400 ${e} C365 ${e+31} 282 ${e+31} 255 ${e} Z`,fill:"#e2d3b3",stroke:qa,strokeWidth:"1.8"}),t.jsx("path",{d:`M257 ${e-9} Q323 ${e-45} 397 ${e-9}`,fill:"none",stroke:X1,strokeWidth:"0.9"}),t.jsx("circle",{cx:"326",cy:e,r:"25",fill:"#c0ac85",stroke:qa,strokeWidth:"1.1"}),Array.from({length:20},(i,h)=>{const u=h*Math.PI/10;return t.jsx("path",{d:`M${326+Math.cos(u)*19} ${e+Math.sin(u)*19} L${326+Math.cos(u)*24} ${e+Math.sin(u)*24}`,stroke:X1,strokeWidth:"0.9"},h)}),t.jsx("circle",{cx:"326",cy:e,r:n,fill:Ly}),t.jsx("circle",{cx:"320",cy:e-8,r:"3",fill:H4}),t.jsx("text",{x:"326",y:e+42,fill:qa,fontFamily:"Georgia, serif",fontSize:"11",fontWeight:"700",textAnchor:"middle",letterSpacing:"0.6",children:c})]},e)),t.jsxs("g",{fill:qa,fontFamily:"Georgia, serif",textAnchor:"middle",fontSize:"10",children:[t.jsx("text",{x:"85",y:"181",children:"ДОСМОТРОВЫЙ"}),t.jsx("text",{x:"85",y:"195",children:"ФОНАРИК"})]}),t.jsx("path",{d:"M20 233 H420",fill:"none",stroke:qa,strokeWidth:"0.9"}),t.jsx("text",{x:"220",y:"246",fontFamily:"Georgia, serif",fontSize:"9",textAnchor:"middle",fill:"#5b4326",children:"Сравните зрачок до и после освещения"})]})}const Hy={day:7,issueNumber:"ВЫПУСК № 291 · ДОПОЛНЕНИЕ К ДОСМОТРОВОЙ ДИРЕКТИВЕ",dateLabel:"ПОНЕДЕЛЬНИК, 18 ОКТЯБРЯ 1943 Г. · СЕДЬМАЯ НОЧЬ",weatherLabel:"МОРОЗНЫЙ ТУМАН · −8°C",priceLabel:"СЛУЖЕБНЫЙ ЭКЗЕМПЛЯР",shiftBanner:"ШЕСТАЯ НОЧЬ ПОЗАДИ · ВВОДИТСЯ ОСМОТР РУЧНОЙ КЛАДИ",mainHeadline:"ОБЫЧНЫЕ ГЛАЗА БОЛЬШЕ НЕ ГАРАНТИЯ",mainDeck:"Новые сведения о маскировке Werwolf, Nachzehrer и Meerleute. Проверяйте содержимое сумок и несколько независимых признаков.",col1:{rubric:"СЛУЖЕБНОЕ НАБЛЮДЕНИЕ",title:"Мимикрия под гражданский взгляд",dropCap:"П",lead:"олевые группы сообщают: с этой ночи Werwolf, Nachzehrer и Meerleute могут появляться с обычным цветом глаз и круглым зрачком. Цвет сам по себе больше не позволяет исключить угрозу.",paragraphs:["Примерно в половине случаев эти три вида маскируют глаза. Когти, перепонки, грязь под ногтями, чешуя и другие признаки при этом не исчезают.","Blutsauger и двойники сохраняют прежние особенности. Проба светом и осмотр обеих рук остаются обязательными методами проверки."]},col2:{rubric:"ОПИСЬ ИЗЪЯТОГО",title:"Небольшой флакон среди дорожных вещей",caption:"Рис. 7. «Belladonna · Augentropfen» — флакон из ручной клади. Внимательно читайте этикетку.",paragraphs:["У части существ с замаскированными глазами при досмотре находят немецкие глазные капли с надписью «Belladonna · Augentropfen». Флакон лежит среди билетов, платков и прочих вещей.","Капли встречаются лишь у половины таких посетителей. Если флакона нет, это не исключает маскировку. Находка не подсказывает конкретный вид — сопоставляйте её с результатами остальных проверок."]},col3:{rubric:"ПОРЯДОК НА НОЧЬ 7",title:"Открыть сумку, а не угадывать по поведению",paragraphs:["Новый раздел «Сумка» позволяет попросить посетителя выложить содержимое на стол. При заминке объясните порядок досмотра или напомните о правилах. Реакции граждан не являются доказательством вида."],directiveTitle:"ДОПОЛНИТЕЛЬНЫЕ ПРАВИЛА:",directiveItems:["Обычный цвет глаз и круглый зрачок не означают, что перед вами человек.","Откройте «Сумка» и попросите выпотрошить её на стол.","Нажмите на флакон, прочитайте этикетку и отметьте находку в записной книжке.","Капли можно указать среди улик при вызове тревоги. Конкретный вид определяйте по другим признакам.","Закрытая сумка и отсутствие флакона — не доказательства невиновности или вины."]},buttonLabel:"ЗАСТУПИТЬ НА СЕДЬМУЮ НОЧЬ"},Wy={day:8,issueNumber:"ВЫПУСК № 292 · РЕЧНАЯ СВОДКА",dateLabel:"ВТОРНИК, 19 ОКТЯБРЯ 1943 Г. · ВОСЬМАЯ НОЧЬ",weatherLabel:"СЫРОЙ ВЕТЕР С РЕКИ · −3°C",priceLabel:"СЛУЖЕБНЫЙ ЭКЗЕМПЛЯР",shiftBanner:"СЕДЬМАЯ НОЧЬ ПОЗАДИ · ИЗ РЕКИ ВЫХОДЯТ NIXEN",mainHeadline:"РЕЧНОЙ НАРОД В ОЧЕРЕДЯХ: КТО ТАКИЕ NIXEN",mainDeck:"Комендатура предупреждает: с этой ночи под видом путников приходят речные существа. Их кожа неотличима от человеческой — ищите капли на стекле, зеленоватые зубы и тину под ногтями.",col1:{rubric:"ДОКЛАД НАБЛЮДАТЕЛЕЙ",title:"Кожа как у людей, а выдох — с каплями",dropCap:"П",lead:"атрули у речных шлюзов доложили о путниках, которых не отличить от граждан: ни чешуи, ни перепонок, ни холодного отлива кожи. Глаза часто голубые, но голубые глаза — не доказательство и не оправдание.",paragraphs:["Выдох Nixen оставляет на стекле водянистые капли. У мужчин при осмотре рта заметны зеленоватые зубы; у женщин под ногтями находят речную тину.","На вопросы речные путники отвечают о стирке у воды, огороде и дешёвой краске. Отговорки записывайте, но приметы не отменяйте."]},col2:{rubric:"ПАМЯТКА ОСМОТРА",title:"Не спутать реку с морем и с человеком",caption:"Рис. 8. Камыш у шлюза: речные путники выходят на берег.",paragraphs:["Все привычные приметы морского народа здесь не работают: у Nixen нет ни чешуи, ни перепонок, ни солёного следа на стекле.","Помните разницу выдоха: морской народ оставляет белёсый солёный налёт, а речной — водянистые капли.","Спрашивайте о зелени под ногтями и о цвете зубов: речные мужчины и женщины отвечают про тину, бельё и огород. Ответ не отменяет приметы."]},col3:{rubric:"ПРИКАЗ КОМЕНДАНТА НА НОЧЬ 8",title:"Различать реку, море и человека",paragraphs:["С этой ночи в очередях встречаются Nixen. Обычные кожа и глаза не оправдывают путника: решают проба дыхания, зубы и ногти."],directiveTitle:"ОБЯЗАТЕЛЬНО К ИСПОЛНЕНИЮ (НОЧЬ 8):",directiveItems:["Капли на стекле — след Nixen; морской народ, как известно, оставляет солёный белёсый налёт.","У мужчин Nixen зубы зеленоватые; у женщин под ногтями тина. Отговорки про краску, стирку и огород не отменяют приметы.","Кожа без чешуи и перепонок и голубые глаза не оправдывают путника с реки.","Волосы, седина, вторая челюсть и проба светом остаются в силе."]},buttonLabel:"ЗАСТУПИТЬ НА ВОСЬМУЮ НОЧЬ"},_y={day:9,issueNumber:"ВЫПУСК № 293 · СВОДКА О ВОДЕ",dateLabel:"СРЕДА, 20 ОКТЯБРЯ 1943 Г. · ДЕВЯТАЯ НОЧЬ",weatherLabel:"СЫРОЙ ТУМАН, ВЕТЕР С ВОДОХРАНИЛИЩА · −2°C",priceLabel:"СЛУЖЕБНЫЙ ЭКЗЕМПЛЯР СД",shiftBanner:"ВОСЬМАЯ НОЧЬ ПОЗАДИ · ВОДА МУТНЕЕТ",mainHeadline:"ВРАГ ОТРАВЛЯЕТ ВОДУ: ЧЕШУЙЧАТЫЙ УЗОР НЕ ВСЕГДА ЗНАЧИТ MEERLEUTE",mainDeck:"После диверсий на водозаборах качество воды ухудшилось. Врачи предупреждают: у людей тоже может появиться чешуйчатый узор, похожий на экзему.",col1:{rubric:"ВОДНАЯ СВОДКА ОКРУГА",title:"Мутные колодцы и белая плёнка на вёдрах после вражеских диверсий",dropCap:"В",lead:"ражеские группы бьют по насосным станциям и сбрасывают в реки неизвестную дрянь. Вода в приграничных деревнях пахнет железом, тиной и хлорной известью.",paragraphs:["Санитарные врачи сообщают о случаях раздражения кожи: у людей проступают сухие чешуйчатые пятна на руках, шее и лице. Это может быть экзема от испорченной воды, а не признак морского народа.","Комендатура требует кипятить воду и не трогать белёсый осадок голыми руками. Виновники диверсий рассчитывают посеять панику и заставить посты стрелять в собственных граждан."]},col2:{rubric:"ПАМЯТКА ДЕЖУРНОМУ ВРАЧУ",title:"Чешуя на коже: экзема, вода или Meerleute?",caption:"Рис. 9. Наблюдение у речной заставы: мутная вода и следы на коже.",paragraphs:["Чешуйчатый узор теперь встречается и у людей. Они могут назвать его экземой, аллергией на воду или следом от дешёвого мыла — и это объяснение иногда бывает правдой.","Meerleute тоже способны сослаться на экзему, чтобы скрыть происхождение. Одной кожи недостаточно: ищите перепонки, перламутровые ногти, острые зубы и солёный налёт на стекле.","Не путайте испорченную речную воду с морским следом. Капли, тина и зелёные зубы остаются отдельными приметами Nixen."]},col3:{rubric:"ПРИКАЗ КОМЕНДАНТА НА НОЧЬ 9",title:"Проверять воду, кожу и бумаги без паники",paragraphs:["С этой ночи клерк обязан отличать испорченную воду и человеческую экзему от признаков Meerleute. Признание «это экзема» не оправдывает и не обвиняет само по себе: сопоставляйте несколько независимых улик."],directiveTitle:"ОБЯЗАТЕЛЬНО К ИСПОЛНЕНИЮ (НОЧЬ 9):",directiveItems:["Чешуйчатый узор может быть у человека. Спросите, не связано ли это с водой или экземой.","Meerleute могут ответить «экзема» так же, как обычный человек. Проверяйте перепонки, ногти, зубы и солёный выдох."]},buttonLabel:"ЗАСТУПИТЬ НА ДЕВЯТУЮ НОЧЬ"},Ey={day:10,issueNumber:"ВЫПУСК № 294 · НОЧНАЯ СВОДКА",dateLabel:"ЧЕТВЕРГ, 21 ОКТЯБРЯ 1943 Г. · ДЕСЯТАЯ НОЧЬ",weatherLabel:"НИЗКИЕ ОБЛАКА, СЫРОЙ ВЕТЕР · +1°C",priceLabel:"СЛУЖЕБНЫЙ ЭКЗЕМПЛЯР СД",shiftBanner:"ДЕВЯТАЯ НОЧЬ ЗАВЕРШЕНА · НОВЫЙ ПОРЯДОК УЧЁТА",mainHeadline:"ГЛАВА ТОТАЛЬНОЙ МОБИЛИЗАЦИИ ПРИБУДЕТ СО ДНЯ НА ДЕНЬ",mainDeck:"Пограничные посты переводят прибывающих на единую ведомость роста и веса; в округе продолжаются военные и ночные происшествия.",col1:{rubric:"СВОДКА С ФРОНТА",title:"Восточные составы проходят через разбитые узлы связи",dropCap:"В",lead:"оенные корреспонденты сообщают о тяжёлых боях на восточном направлении. Ночью эшелоны идут затемнёнными, а санитарные платформы принимают раненых прямо у временных станций.",paragraphs:["Из-за повреждения путей колонны прибывают с задержкой. В штабах сверяют списки личного состава, номера вагонов и краткие ведомости сопровождения.","Официальные сообщения не раскрывают маршрут представителя, который должен прибыть в округ со дня на день и принять дела по тотальной мобилизации."]},col2:{rubric:"ХРОНИКА НЕЖИТИ",title:"Ночные дела возвращаются в архивы постов",caption:"Рис. 10. Ведомость, весы и ростомер в комнате переписи.",paragraphs:["В архиве окружного управления обнаружены записи о посетителях, которые числились умершими задолго до появления у ворот. В старых карточках встречаются неподвижные зрачки, голоса без дыхания и отказ показывать содержимое сумок.","Отдельные свидетельства рассказывают о существах, узнававших имена дежурных и проходивших под чужими документами. Записи переданы на повторную проверку.","На восточном направлении продолжаются бои, а в окрестных деревнях снова замечены фигуры, выходящие к дорогам после полуночи."]},col3:{rubric:"КАТАЛОГ ОКРУГА",title:"Рост и вес каждого прибывающего вносятся обязательно",paragraphs:["С десятой ночи карточка посетителя считается неполной без двух измерений. Для взвешивания прибывающий встаёт на весы, после чего подходит к другому клерку для измерения роста.","При отсутствии хотя бы одной записи нельзя поставить печать на документы и нельзя вызвать СД. Требование распространяется на каждого посетителя без исключений."],directiveTitle:"ОБЯЗАТЕЛЬНЫЕ ПОЛЯ · НОЧЬ 10:",directiveItems:["Вес: запись после взвешивания на посту.","Рост: запись у другого клерка.","Нет двух записей — нет печати и вызова СД."]},buttonLabel:"ЗАСТУПИТЬ НА ДЕСЯТУЮ НОЧЬ"},Ty={day:11,issueNumber:"ВЫПУСК № 295 · НОЧНАЯ СВОДКА",dateLabel:"ПЯТНИЦА, 22 ОКТЯБРЯ 1943 Г. · ОДИННАДЦАТАЯ НОЧЬ",weatherLabel:"ПАСМУРНО, СЕВЕРНЫЙ ВЕТЕР · 0°C",priceLabel:"СЛУЖЕБНЫЙ ЭКЗЕМПЛЯР СД",shiftBanner:"ДЕСЯТАЯ НОЧЬ ЗАВЕРШЕНА · ПОРЯДОК СОХРАНЯЕТСЯ",mainHeadline:"БУДУЩИЕ ПОБЕДЫ НАЧИНАЮТСЯ С ПОРЯДКА",mainDeck:"Точная служебная запись, выдержка на постах и уверенность в завтрашнем дне приближают победный час.",col1:{rubric:"СВОДКА С ФРОНТА",title:"Впереди — победа и новое европейское будущее",dropCap:"В",lead:"се испытания нынешних дней лишь закаляют волю к окончательному успеху. На восточном направлении войска и тыловые службы продолжают выполнять долг, не уступая ни одной трудности.",paragraphs:["Военные корреспонденты отмечают, что за каждым спокойным рапортом, исправно прибывшим составом и сохранённой ведомостью стоит общий труд страны. Порядок сегодня — уверенность в победе завтра.","В городах и на пограничных постах призывают смотреть вперёд без колебаний: будущие победы потребуют выдержки, точности и верности своему месту службы."]},col2:{rubric:"СЛОВО ДНЯ",title:"Дисциплина сегодняшнего дня — залог побед завтра",caption:"Рис. 11. Дорога к будущему начинается с верного шага.",paragraphs:["Каждый служащий отвечает не только за сегодняшний час, но и за тот порядок, на котором будет построено мирное будущее. Небольшая задержка, неточная запись или беспечность на посту отзываются далеко за пределами одной смены.","Поэтому спокойная работа без лишних слов становится вкладом в общий успех. Победа складывается из ежедневной точности — в штабе, в вагоне, на складе и у пограничного шлагбаума.","Пусть трудная ночь напоминает: впереди новый день, новые задачи и новые победы."]},col3:{rubric:"ВЗГЛЯД ВПЕРЁД",title:"После трудных дней — новая мирная работа",paragraphs:["Когда нынешние испытания останутся позади, стране понадобятся спокойные руки, точные расчёты и люди, умеющие держать слово. Будущее уже строится в сегодняшней выдержке.","На границе, как и в каждом городе, верят: порядок, сохранённый в трудный час, станет основой для большого восстановления и счастливой жизни после победы."],directiveTitle:"",directiveItems:[]},buttonLabel:"ЗАСТУПИТЬ НА ОДИННАДЦАТУЮ НОЧЬ"},Qy={day:12,issueNumber:"ВЫПУСК № 296 · НОЧНАЯ СВОДКА",dateLabel:"СУББОТА, 23 ОКТЯБРЯ 1943 Г. · ДВЕНАДЦАТАЯ НОЧЬ",weatherLabel:"РЕЗКОЕ ПОХОЛОДАНИЕ, СЕВЕРНЫЙ ВЕТЕР · −6°C",priceLabel:"СЛУЖЕБНЫЙ ЭКЗЕМПЛЯР СД",shiftBanner:"ОДИННАДЦАТАЯ НОЧЬ ЗАВЕРШЕНА · ХОЛОДНЫЙ ФРОНТ",mainHeadline:"КРЕПКОЕ СЛОЖЕНИЕ ТРЕБУЕТ ВНИМАНИЯ НА ВЕСАХ",mainDeck:"При проверке Werwolf смотрите не только на лицо и руки: плотные кости могут сделать вес заметно больше привычного.",col1:{rubric:"СВОДКА С ФРОНТА",title:"Мороз сковывает дороги и задерживает ночные составы",dropCap:"К",lead:" вечеру северный ветер усилился, а температура у станций опустилась ниже прежних прогнозов. Полевые дороги покрываются коркой льда, движение между узлами замедлено.",paragraphs:["На открытых платформах пассажирам выдают дополнительные одеяла и разрешают ненадолго укрываться в служебных помещениях. Пограничные посты работают в прежнем режиме, несмотря на холод.","Синоптики предупреждают: в ближайшие ночи следует ждать новых заморозков. Вода в придорожных канавках уже схватывается льдом до рассвета."]},col2:{rubric:"ЗАМЕТКА ДЛЯ ПОСТОВ",title:"Плотные кости могут выдать Werwolf",caption:"Рис. 12. Северный пограничный пост после снегопада.",paragraphs:["У Werwolf кости плотнее человеческих. Поэтому человек обычного роста может весить ощутимо больше, чем ожидаешь, даже если под одеждой ничего необычного не видно.","После несчастного случая на северном посту об этом заговорили особенно внимательно. Посетитель поскользнулся на обледенелой ступени, и двоим служащим пришлось с трудом поднимать его с земли. В карточке он выглядел человеком обычного роста.","Не списывайте непривычную тяжесть сразу на шинель, сапоги или дорожные вещи. На морозе люди кутаются плотнее, но странно крепкая фигура при обычном росте всё же заслуживает внимательного взгляда."]},col3:{rubric:"ПОГОДА В ОКРУГЕ",title:"Ночь будет долгой и очень холодной",paragraphs:["К полуночи ожидается дальнейшее падение температуры. Дежурным рекомендуют держать горячую воду у печи и не оставлять наружные двери открытыми дольше необходимого.","Первый снег возможен до рассвета. На стекле окон уже появляется тонкая белая кромка."],directiveTitle:"",directiveItems:[]},buttonLabel:"ЗАСТУПИТЬ НА ДВЕНАДЦАТУЮ НОЧЬ"};function Ay(){return t.jsxs("svg",{v