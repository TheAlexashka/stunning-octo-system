 66 150 60Z"]}]},R3={id:"hair-m3040-brush-crop",name:"Щётка вперёд с чёлкой",years:"1930-е",caption:"Short brush cut combed forward, soft fringe",position:"Ряд 1, портрет 2: мужчина с гримасой",description:"Коротко, без пробора, всё направлено вперёд; над лбом рваная чёлка на 3–4 мм ниже линии роста.",construction:"Контур низкий (верх 31), линия роста зубчатая и опущена до 54. Пряди идут веером от макушки к лицу — противоположно всем остальным укладкам набора. Волн нет.",referenceView:"На постере анфас.",bbox:[111,26,78,66],back:[it(96,321,1.2)],front:[{d:"M118 88C113 72 113 48 123 39C131 33 141 31 150 31C159 31 169 33 177 39C187 48 187 72 182 88L178 86C180 72 180 60 176 55L171 56L167 53L162 55L157 52L152 54L147 52L142 54L137 52L132 55L128 54C123 60 121 72 122 86Z",strands:Me([[150,31],[136,34],[124,44]],[[150,55],[140,54],[128,55]],12).concat(Me([[150,31],[164,34],[176,44]],[[150,55],[160,54],[172,55]],12)),highlights:["M128 40C140 34 160 34 172 40C160 37 140 37 128 40Z"],taper:[...Ot(331,1.1,62),...$h(341,.8,33,250)]}]},N3={id:"hair-m3040-curly-quiff",name:"Кудрявый верх с завитком",years:"1940-е",caption:"Curly top, one big curl dropping over the forehead",position:"Ряд 1, портрет 3: рыжий юноша, улыбка",description:"Бока короткие, верх кудрявый и объёмный, а надо лбом один большой завиток спускается почти до брови.",construction:"Контур бугристый: пять выпуклостей по макушке до y=21. Кудри — четыре короткие волны с амплитудой 4 и двумя гребнями. Завиток на лбу — волна с фазой 4.7 и двумя гребнями, идущая вниз.",referenceView:"На постере три четверти. Единственная укладка набора с завитком ниже линии роста.",bbox:[106,16,90,78],back:[it(100,351)],front:[{d:"M116 90C110 72 108 50 116 38C119 28 128 22 136 25C142 18 154 18 160 24C170 20 180 26 182 36C190 44 191 62 185 90L179 88C182 70 181 58 175 53C167 49 158 50 150 50C142 50 133 51 128 55C122 60 120 72 121 89Z",strands:[...Me([[120,44],[118,60],[118,84]],[[128,46],[124,60],[122,84]],6),...Me([[180,44],[184,60],[184,84]],[[172,46],[178,60],[180,84]],6)],highlights:["M132 30C142 22 160 22 172 30C160 26 142 26 132 30Z"],taper:Ot(361),waves:[Ht(122,40,142,28,4,2,7,5,.3),Ht(140,27,162,24,4.2,2,7.5,5.5,1.4),Ht(160,25,180,38,4,2,7,5,2.6),Ht(128,46,172,42,3.4,2.6,6.5,5,.9),Ht(156,50,150,66,4.6,1.6,7,3.5,4.7)]}]},Z3={id:"hair-m3040-patent-slick",name:"Лаковый плоский пробор",years:"1930-е",caption:"Patent-leather slick with a knife-edge part",position:"Ряд 1, портрет 4: лицо размыто",description:"Волосы лежат как лакированные: ни одной выбившейся пряди, плоско к черепу, узкий пробор, длинный блик.",construction:"Контур точно повторяет череп (верх 32, без объёма). Волн нет. Два длинных узких блика вдоль прочёса, самый широкий блик набора. Окантовка малозаметна.",referenceView:"На постере анфас.",bbox:[111,26,78,66],back:[it(98,371,.9)],front:[{d:"M117 88C112 70 112 50 122 41C130 35 140 32 150 32C160 32 170 35 178 41C188 50 188 70 183 88L178 86C181 72 180 58 174 52C167 48 158 50 150 50C142 50 133 48 126 52C120 58 119 72 121 86Z",strands:[...Me([[133,34],[121,44],[118,66]],[[134,50],[125,54],[121,76]],6),...Me([[135,33],[160,32],[180,44]],[[136,50],[158,50],[176,58]],24)],highlights:["M137 36C154 31 172 34 180 46C168 38 152 37 137 40Z","M124 46C130 42 138 42 144 46C138 45 130 46 124 48Z"],part:"M134 33C133 40 134 46 135 50",taper:Ot(381,.7)}]},O3={id:"hair-m3040-blond-quiff",name:"Высокий кок",years:"1940-е",caption:"Tall quiff pushed up and back off the forehead",position:"Ряд 2, портрет 1: блондин на фоне афиш",description:"Спереди волосы подняты высокой волной, самая высокая точка над правой бровью, затем масса уходит назад. Бока прижаты.",construction:"Самый высокий контур набора: фронтальный бугор до y=14 на x=156. Слева и на макушке контур обычный, объём только спереди. Одна крупная волна с амплитудой 5 описывает скат кока.",referenceView:"На постере три четверти, ракурс снизу. Высота сохранена.",bbox:[106,10,90,82],back:[it(102,401)],front:[{d:"M116 90C110 72 110 48 120 38C126 32 132 30 138 30C140 20 150 12 160 14C172 16 178 26 178 36C186 44 190 64 185 90L179 88C182 72 181 60 176 54C170 50 160 50 152 51C144 50 136 51 131 53C125 58 121 68 121 80L121 89Z",strands:[...Me([[130,34],[119,46],[117,70]],[[131,52],[124,60],[121,84]],7),...Me([[136,32],[146,15],[168,17],[178,40]],[[136,52],[148,46],[166,48],[176,58]],22)],highlights:["M142 20C150 13 166 14 174 24C164 17 152 17 142 24Z"],shadows:["M136 50C146 44 162 44 174 50C162 48 146 48 136 52Z"],part:"M130 32C129 40 130 46 131 52",taper:Ot(411),waves:[Ht(138,30,176,38,5,.9,12,7,.5)]}]},Pl=(s,e,n,c="down")=>[{region:"left-temple",start:(s-33)/97,end:.61,width:.14,density:n,length:.024,fadeTo:c,seed:e},{region:"right-temple",start:(s-33)/97,end:.61,width:.14,density:n,length:.024,fadeTo:c,seed:e+50},{region:"nape",start:.4,end:.92,width:.86,density:n,length:.022,fadeTo:c,seed:e+100}],D3={id:"hair-m3040-clipped-sides-slick",name:"Стерня на висках, верх назад",years:"1930-е",caption:"Sides clipped to stubble, top slicked back",position:"Ряд 2, портрет 2: офицер в мундире, светлые глаза",description:"Виски и бока сняты машинкой до 1–2 мм: серая стерня от уровня брови до уха. На макушке волосы длиннее и зачёсаны назад без пробора.",construction:"Длинные волосы кончаются ровной кромкой. Короткие тонкие волоски строятся по боковым сечениям головы в отдельном слое scalp. Размер верхних и задних волос не сдвигает стерню.",referenceView:"На постере анфас. Переход «длинные → стерня» резкий, как у машинной стрижки того времени.",bbox:[108,26,84,66],scalp:Pl(58,441,.55),back:[it(94,431,1.4)],front:[{d:"M118 58C116 46 120 36 132 32C138 30 144 30 150 30C156 30 162 30 168 32C180 36 184 46 182 58L177 58C179 50 174 47 164 47C158 47 152 48 150 48C148 48 142 47 136 47C126 47 121 50 123 58Z",strands:Me([[128,46],[126,36],[140,31]],[[172,46],[174,36],[160,31]],18),highlights:["M130 37C142 31 158 31 170 37C158 34 142 34 130 37Z"],shadows:["M120 56C132 54 168 54 180 56C168 58 132 58 120 58Z"]}]},z3={id:"hair-m3040-heydrich-part",name:"Высокий пробор, стерня на висках",years:"1930-е",caption:"High side part, long top swept back, temples clipped to stubble",position:"Отдельное фото: офицер в сером мундире, светлые волосы",description:"Пробор высоко слева, длинные светлые волосы гладко назад и чуть вправо. От уровня брови до уха — серая стерня, переход к длинным волосам резкий и ровный.",construction:"Высокая кромка длинных волос и плотность стерни 0.5. Волоски в третьем слое следуют границе головы, а не массе волос. Затылочная зона показывается только на настоящем виде головы сзади.",referenceView:"На фото три четверти. Пробор дан слева от зрителя, как на снимке.",bbox:[108,24,84,70],scalp:Pl(56,831,.5),back:[it(94,811,.9)],front:[{d:"M118 56C115 44 118 34 128 30C134 27 142 26 150 27C160 26 172 30 178 38C183 44 184 50 182 56L177 56C179 50 176 46 170 44C162 42 156 46 150 48C146 48 140 46 134 46C126 46 121 50 123 56Z",strands:[...Me([[131,30],[122,40],[120,54]],[[133,46],[126,50],[124,56]],6),...Me([[133,28],[156,27],[176,38]],[[134,47],[154,48],[172,50]],20)],highlights:["M136 31C152 26 168 30 176 40C166 33 152 32 136 36Z"],shadows:["M120 54C132 52 168 52 180 54C168 56 132 56 120 56Z"],part:"M131 29C130 36 131 42 133 47"}]},B3={id:"hair-m3040-himmler-flat",name:"Плоский пробор, короткий затылок",years:"1930-е",caption:"Flat, thin side part, back and sides clipped very short",position:"По описанию: гладкие плоские волосы, пробор чуть левее центра",description:"Волосы тонкие и лежат плоско, пробор чуть левее центра, виски и затылок сняты машинкой почти до кожи — стерня светлее и реже, чем у Гейдриха.",construction:"Плоский верх без волн. Зона машинки ниже, чем у высокого пробора. Тонкие волоски плотностью 0.35 следуют голове независимо от верхнего и заднего слоёв.",referenceView:"Реконструкция по типовому облику. Очки к причёске не относятся.",bbox:[110,26,80,66],scalp:Pl(62,871,.35),back:[it(94,851,.7)],front:[{d:"M119 62C116 50 118 40 126 35C133 31 141 30 150 30C159 30 168 32 175 37C182 42 184 52 181 62L176 62C178 52 176 48 170 47C160 46 154 50 150 51C146 50 138 47 132 47C124 48 122 54 124 62Z",strands:[...Me([[140,32],[126,40],[124,56]],[[141,50],[132,50],[126,60]],8),...Me([[142,31],[162,31],[176,42]],[[143,50],[160,50],[174,56]],14)],highlights:["M144 34C158 30 170 34 176 44C166 37 156 36 144 38Z"],part:"M141 31C140 38 141 44 142 50"}]},G3={id:"hair-m3040-youth-undercut",name:"Длинная чёлка, стерня по бокам",years:"1930-е",caption:"Long swept fringe over the forehead, sides and back clipped high",position:"По типовому облику: юношеская стрижка 1930-х",description:"Верх оставлен длинным и зачёсан вбок, тяжёлая чёлка падает на лоб до брови. Виски и затылок сняты высоко, стерня начинается выше уха.",construction:"Высокая зона стерни с плотностью 0.45 находится на голове, не на причёске. Чёлка скошена по диагонали и сужается к слегка смягчённому острию; округлый каплевидный конец убран.",referenceView:"Реконструкция по типовому облику, анфас.",bbox:[108,24,84,70],scalp:Pl(52,911,.45),back:[it(92,891,1.1)],front:[{d:"M120 52C118 42 122 32 132 29C138 27 144 26 150 26C158 26 168 28 176 34C182 40 184 46 182 52L177 52C179 46 174 44 166 44C160 44 154 47 150 48C146 48 140 45 134 45C126 45 122 48 124 52Z",strands:[...Me([[130,30],[122,38],[121,50]],[[132,45],[126,46],[124,52]],5),...Me([[132,28],[156,26],[176,36]],[[133,46],[154,47],[172,48]],16)],highlights:["M134 31C150 25 166 28 174 38C164 31 150 30 134 35Z"],part:"M130 29C129 35 130 40 132 46"},{d:"M133 46C144 43.8 156 44.8 165 49C171 52 174.5 57.2 177.4 63.9L179.2 66.5Q179.6 67.1 178.9 66.85L173.3 65.1L169.9 62.6Q162.5 60.2 156.5 55.8C148.6 51.5 140.6 49.8 133 49.8Z",strands:["M135 46.8C148 46.3 164 53.4 175.8 64.3","M138 46C152 46.4 167 53.4 178.4 66.1","M135 48C148 49.1 160 55.1 170.5 61.8","M144 45.1C157 46.6 170.2 54.4 177.4 64.9","M139 47.1C153 48.9 165.7 55.6 174.6 64.5"],highlights:["M137 46C150 44.7 161 48.4 169 55.2C159 50 148.5 48 137 47.6Z"],shadows:["M158 56.9Q166 61.6 173.3 65.1L177.6 66.3Q168.8 62.7 158 56.9Z"]}]},U3={id:"hair-m3040-tousled-waves",name:"Естественные волны назад",years:"1930-е",caption:"Natural waves brushed back, no product",position:"Ряд 2, портрет 3 (пловец) и ряд 3, портрет 4 (с сигаретой) — объединены",description:"Волосы откинуты назад пальцами, не гребнем: волны лежат неровно, объём естественный, блеска почти нет.",construction:"Контур с тремя неровными выпуклостями до y=25. Четыре волны с разными фазами и амплитудами, ленты широкие. Блик намеренно маленький, чтобы читалась сухая текстура.",referenceView:"Портрет 7 анфас, портрет 12 три четверти. Различаются только зачёсом, взята общая форма.",bbox:[106,20,90,76],back:[it(104,461)],front:[{d:"M115 90C109 72 108 48 118 36C124 28 132 26 140 27C146 24 156 24 162 27C170 26 178 30 182 38C190 48 190 68 185 90L179 88C182 70 181 58 175 53C167 49 158 50 150 50C142 50 133 51 128 55C122 60 120 72 121 89Z",strands:[...Me([[128,52],[122,36],[140,27]],[[172,52],[178,36],[160,27]],14)],highlights:["M140 31C150 27 160 27 168 31C160 29 150 29 140 31Z"],taper:Ot(471,.8),waves:[Ht(122,44,146,29,3.6,1.4,9,6,.2),Ht(140,30,170,30,3,1.5,8,6,1.9),Ht(160,31,182,46,3.4,1.3,9,5.5,3.6),Ht(130,48,172,44,2.4,2,7,5,2.4)]}]},Y3={id:"hair-m3040-close-crop",name:"Плотный ёжик",years:"1930-е",caption:"Tight close crop all over",position:"Ряд 2, портрет 4: трубач с улыбкой",description:"Волосы сняты одной длиной по всей голове, лежат плотной ровной шапкой без направления.",construction:"Контур точно по черепу, прядей нет вовсе. Вся текстура — поле коротких штрихов в три ряда с разным углом; ползунок окантовки управляет всей причёской.",referenceView:"На постере три четверти.",bbox:[111,27,78,64],back:[it(96,481,1.6)],front:[{d:"M118 88C113 72 113 50 122 41C130 35 140 33 150 33C160 33 170 35 178 41C187 50 187 72 182 88L178 86C180 72 179 60 173 54C167 50 158 51 150 51C142 51 133 50 127 54C121 60 120 72 122 86Z",highlights:["M130 42C142 36 158 36 170 42C158 40 142 40 130 42Z"],taper:[...$h(491,1.5,35,262),...Ot(501,1.6,58)]}]},q3={id:"hair-m3040-receding-thin",name:"Редеющие назад",years:"1930-е",caption:"Thinning hair combed back off a high forehead",position:"Ряд 3, портрет 1: мужчина в возрасте, взгляд вниз",description:"Лоб высокий, у висков глубокие залысины, оставшиеся волосы тонкие и зачёсаны назад.",construction:"Линия роста поднята: центр на 60, углы у висков уходят до 42. Контур низкий. Прядей мало (10 против обычных 20+), они редкие и видна кожа между ними.",referenceView:"На постере три четверти. Самая высокая линия роста набора.",bbox:[111,28,78,64],back:[it(98,521,.8)],front:[{d:"M118 88C113 70 113 50 122 42C130 36 140 34 150 34C160 34 170 36 178 42C187 50 187 70 182 88L178 86C181 72 180 56 172 44C166 48 156 58 150 60C144 58 134 48 128 44C122 54 120 70 122 86Z",strands:Me([[130,40],[124,52],[122,72]],[[136,42],[130,54],[124,76]],5).concat(Me([[140,38],[160,36],[176,46]],[[142,54],[158,56],[174,58]],10)),highlights:["M136 40C150 35 166 37 176 46C164 41 150 40 136 44Z"],taper:Ot(531,1.1,60)}]},V3={id:"hair-m3040-youth-side-part",name:"Косой пробор, зачёс вниз",years:"1930-е",caption:"High side part, hair combed diagonally down across the head",position:"Ряд 3, портрет 2: лицо размыто, тёмный галстук",description:"Пробор высоко слева, всё зачёсано вправо и вниз плоской пластиной; края чёткие, бока коротко.",construction:"Линия роста справа идёт диагонально вниз до y=58 и обрывается ровной кромкой — это пластина волос, а не волна. Слева над ухом волосы сняты до y=62 с плотной стернёй ниже.",referenceView:"На постере анфас.",bbox:[110,26,80,64],back:[it(94,551,1.4)],front:[{d:"M126 64C118 52 120 38 130 34C136 31 142 31 148 31C160 30 174 33 180 42C186 50 186 66 182 88L178 86C181 72 180 60 178 58L160 56L145 52C138 50 132 52 128 56C125 58 125 62 126 64Z",strands:Me([[128,34],[124,44],[125,60]],[[130,46],[128,52],[127,62]],4).concat(Me([[130,33],[158,30],[180,44]],[[131,52],[156,54],[178,58]],18)),highlights:["M132 35C150 30 170 33 178 44C166 37 150 36 132 39Z"],part:"M129 33C128 40 128 46 129 54",taper:[ns(114,54,14,34,561,100,1.5),ns(176,64,12,24,571,78,1.1)]}]},X3={id:"hair-m3040-center-part-flat",name:"Пробор посередине",years:"1930-е",caption:"Centre part, hair laid flat to both sides",position:"Ряд 3, портрет 3: узкое лицо, светлые глаза",description:"Единственный симметричный пробор в наборе: волосы разделены точно по центру и уложены плоско на обе стороны.",construction:"Контур низкий и симметричный. Линия роста с двумя мягкими углами по бокам от пробора. Два зеркальных веера прядей от центра к вискам, два блика.",referenceView:"На постере анфас.",bbox:[111,27,78,64],back:[it(98,591)],front:[{d:"M117 88C112 70 112 50 121 41C129 35 139 33 150 33C161 33 171 35 179 41C188 50 188 70 183 88L178 86C181 72 180 58 174 52C167 48 156 52 150 54C144 52 133 48 126 52C120 58 119 72 122 86Z",strands:[...Me([[149,34],[128,36],[120,50]],[[149,54],[136,52],[124,66]],14),...Me([[151,34],[172,36],[180,50]],[[151,54],[164,52],[176,66]],14)],highlights:["M124 44C132 37 142 36 148 38C140 40 132 44 126 50Z","M176 44C168 37 158 36 152 38C160 40 168 44 174 50Z"],part:"M150 33C150 40 150 47 150 54",taper:Ot(601,.9)}]},F3={id:"hair-m3040-forward-fringe",name:"Чёлка на лоб вбок",years:"1930-е",caption:"Flat fringe combed forward and across the forehead",position:"Ряд 4, портрет 1: лицо размыто, тёмная форма",description:"Волосы зачёсаны вперёд и вправо: плоская чёлка закрывает лоб по диагонали, слева выше, справа почти до брови.",construction:"Нижняя кромка чёлки — диагональ от (128,52) до (176,66): единственная укладка, где линия роста заменена краем волос НИЖЕ неё. Прядей вперёд-вправо 18, объёма нет.",referenceView:"На постере анфас.",bbox:[111,27,78,66],back:[it(98,621)],front:[{d:"M117 88C112 70 112 50 121 41C129 35 139 33 150 33C161 33 171 35 179 41C188 50 188 70 183 88L178 86C181 74 180 68 176 66L160 62L144 58L130 54C124 58 121 70 122 86Z",strands:Me([[128,40],[124,46],[122,72]],[[132,50],[128,54],[124,80]],5).concat(Me([[130,36],[156,33],[178,42]],[[130,53],[152,60],[176,65]],18)),highlights:["M132 38C150 32 170 34 178 46C166 39 150 38 132 42Z"],shadows:["M132 52C146 56 162 60 176 65C160 64 146 60 132 55Z"],taper:Ot(631,.9)}]},K3={id:"hair-m3040-clipper-crop",name:"Армейский ёжик",years:"1930-е",caption:"Military clipper cut: stubbled sides, very short flat top",position:"Ряд 4, портрет 2: солдат, взгляд в камеру",description:"Верх — площадка в несколько миллиметров, бока сняты машинкой ещё короче: плотная тёмная стерня от уровня брови и до затылка.",construction:"Площадка без зачёса, короткие штрихи вверх. Стерня плотностью 0.65 без затухания строится в отдельном слое по голове. Ни один её волосок не принадлежит верхней или задней массе волос.",referenceView:"На постере анфас.",bbox:[110,28,80,60],scalp:Pl(60,671,.65,"none"),back:[it(90,651,1.5)],front:[{d:"M122 60C118 50 122 38 134 34C140 33 146 33 150 33C154 33 160 33 166 34C178 38 182 50 178 60L173 60C176 52 170 48 160 48L150 49L140 48C130 48 124 52 127 60Z",highlights:["M134 38C142 34 158 34 166 38C158 36 142 36 134 38Z"],taper:$h(661,1.3,34,272)}]},J3={id:"hair-m3040-pomp-side-part",name:"Пробор с приподнятым передом",years:"1940-е",caption:"Glossy side part with the front lifted into a low pompadour",position:"Ряд 4, портрет 3: улыбающийся мужчина в тёмной рубашке",description:"Чёткий боковой пробор, бока прижаты, а передняя прядь тяжёлой стороны поднята валиком и уходит назад с сильным блеском.",construction:"Отличие от кока: подъём только до y=24 и он начинается у пробора, а не над центром лба. Отличие от пробора Гранта: подъём вверх, а не вниз. Волна с амплитудой 4, широкая лента.",referenceView:"На постере анфас.",bbox:[108,20,86,72],back:[it(100,701)],front:[{d:"M116 90C111 72 111 48 121 38C127 32 134 30 140 30C144 24 156 22 166 26C176 30 182 40 184 50C189 62 188 78 184 90L179 88C182 72 181 60 176 54C170 50 160 50 152 51C144 50 136 51 131 53C125 58 121 68 121 80L121 89Z",strands:[...Me([[131,33],[120,46],[117,70]],[[132,52],[124,60],[121,84]],7),...Me([[133,31],[152,24],[172,30],[182,52]],[[134,52],[152,48],[170,52],[178,62]],22)],highlights:["M144 27C154 22 168 25 176 34C166 27 154 27 144 31Z","M124 48C130 44 138 44 144 48C138 47 130 48 124 50Z"],part:"M131 31C130 39 131 46 132 52",taper:Ot(711),waves:[Ht(136,34,182,44,4,1,11,6,.6)]}]},I3={id:"hair-m3040-dense-wave-part",name:"Густой пробор с волной",years:"1940-е",caption:"Dense dark side part, front rising in a thick wave",position:"Ряд 4, портрет 4: галстук в горошек, взгляд исподлобья",description:"Очень густые волосы, боковой пробор, передняя часть поднимается плотной волной и спадает назад; бока тоже с объёмом.",construction:"Контур широкий по всему периметру (объём и на боках, x 108–192), верх до y=24. Две волны: фронтальная вверх и вторая позади неё. 28 прядей — самая густая штриховка.",referenceView:"На постере три четверти.",bbox:[104,20,92,76],back:[it(104,731,1.1)],front:[{d:"M113 90C106 72 106 46 118 35C126 28 136 25 146 25C154 22 166 24 174 30C184 38 190 50 191 64C193 76 189 84 186 90L180 88C183 72 182 60 177 54C171 50 160 50 152 51C144 50 136 51 131 53C125 58 121 68 121 80L121 89Z",strands:[...Me([[130,30],[118,44],[113,70]],[[132,52],[124,60],[121,84]],9),...Me([[132,28],[156,24],[178,32],[188,62]],[[133,52],[154,50],[172,54],[180,68]],28)],highlights:["M140 28C156 22 172 26 182 40C170 30 154 30 140 34Z"],shadows:["M134 46C146 42 162 42 176 48C162 50 146 50 134 50Z"],part:"M130 28C129 37 130 45 131 52",taper:Ot(741,.8),waves:[Ht(135,33,178,36,4.2,1.1,11,6.5,.4),Ht(140,45,184,52,2.6,1.2,8,5,2.2)]}]},P3={id:"hair-m3040-cap-1943",name:"Кэп 1943: армейский пробор",years:"1940-е",caption:"Precise military side part, tapered sides, softly combed top",position:"Капитан Америка, парадный / USO облик",description:"Очень опрятная стрижка: чёткий пробор на правой половине лица, короткие сведённые бока и гладко причёсанный верх с мягкой волной.",construction:"Единственные укладки набора с пробором СПРАВА (x=168). Тяжёлая масса уходит влево через всю голову, короткая сторона всего 8 прядей против 22. Бока сняты в стерню.",referenceView:"Анфас. Сторона пробора соответствует кадрам «Первого мстителя».",bbox:[108,20,84,74],scalp:Pl(58,951,.45),back:[it(98,941,1.1)],front:[{d:"M112 88C106 66 110 40 126 31C140 23 158 22 172 28C183 33 189 44 188 64C188 74 187 83 186 88L180 86C183 70 182 57 175 52C167 47 157 48 149 49C141 50 133 51 128 54C120 59 117 70 118 86Z",strands:[...Me([[169,31],[180,38],[186,62]],[[168,48],[176,52],[182,76]],8),...Me([[167,29],[140,26],[116,46],[113,78]],[[166,48],[142,50],[124,62],[120,84]],22)],highlights:["M164 33C142 27 122 42 118 56C134 40 146 34 162 37Z"],shadows:["M160 46C142 48 128 54 122 62C132 52 146 47 162 49Z"],part:"M168 29Q169 38 167 48",waves:[Ht(164,36,118,52,2.4,1.05,9,5,.3)]}]},e8={id:"hair-m3040-cap-combat",name:"Кэп в поле: выбившаяся прядь",years:"1940-е",caption:"Field-worn version: broken front lock, matte and textured",position:"Капитан Америка, боевой облик",description:"Та же армейская стрижка после боя: верх взъерошен неровными гребнями, а одна тяжёлая прядь вырвалась и упала на лоб.",construction:"Контур бугристый: три выступа на 120, 144 и 170. Отдельная поверхность-прядь лежит НИЖЕ линии роста, до y=76. Бликов нет совсем — волосы матовые, в отличие от парадной версии.",referenceView:"Анфас. Прядь падает влево от пробора, как в боевых сценах.",bbox:[108,16,84,78],scalp:Pl(58,961,.5),back:[it(100,971,1.05)],front:[{d:"M112 88C105 66 108 40 120 32C126 24 136 21 145 25C151 18 163 19 171 26C183 32 190 46 188 66C188 76 187 84 186 88L180 86C183 70 182 57 175 52C167 47 157 48 149 49C141 50 133 51 128 54C120 59 117 70 118 86Z",strands:[...Me([[170,28],[181,36],[186,62]],[[169,47],[177,51],[182,76]],8),...Me([[168,26],[140,24],[114,44],[112,78]],[[167,47],[142,49],[123,61],[119,84]],24),"M132 30Q138 22 146 27","M150 24Q158 19 166 25"],shadows:["M158 44C140 47 126 53 120 62C130 51 144 45 160 47Z"],part:"M169 27Q170 37 168 47"},{d:"M162 44C150 44 136 50 128 60C123 66 121 72