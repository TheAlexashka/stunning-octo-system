отворно. Дышать на ваше окно я не буду.",reassurance:"Это не насмешка. Проба нужна, чтобы проверить ещё один признак.",reassuredReply:"Я вас {услышал|услышала}, но согласия не даю. Проверяйте другим способом.",reassured:!1,firmReply:"Мой ответ всё тот же. Нет.",persuadedByRules:!1},{agreesImmediately:!0,firstReply:"Пожалуйста. Только покажите чистое место на стекле.",reassurance:"Вот этот участок, не касаясь его.",reassuredReply:"Хорошо.",reassured:!0,firmReply:"Сейчас выдохну.",persuadedByRules:!0},{agreesImmediately:!1,firstReply:"Недавно {переболел|переболела}. Не хочу никого заразить своим дыханием.",reassurance:"Мы по разные стороны стекла. Можно выдохнуть, не снимая дистанцию.",reassuredReply:"Если стекло защищает... Ладно. Сейчас сделаю.",reassured:!0,firmReply:"Хорошо. Я {предупредил|предупредила} вас про болезнь.",persuadedByRules:!0}];function L7(s,e,n,c=!1,i,h="m"){return vl({visitorId:s,paused:e,initial:n,disabled:c,onReply:i,gender:h,subject:"breath",profiles:w7,prompt:"Дыхните на стекло, пожалуйста. Не касайтесь его губами.",insist:"С четвёртой ночи эта проба входит в проверку. Если вы откажетесь, я осмотрю другие признаки."})}const v7=["Трое суток в эшелоне без сна под вой сирен. Глаза щиплет так, словно туда песка насыпали.","На станции ночью попали под дым от горящего состава. Капли не помогали, белки все налились кровью.","У меня хроническое воспаление от угольной пыли в депо. Врач выписал примочки, но в дороге где их взять?","Я плакал{а|} всю ночь перед отъездом... Извините, не могу сдержаться."],g7=["В темноте зрение не напрягал{а|}, в вагоне спал{а|} почти всю дорогу.","Глаза чистые, не жалуюсь. Промываю холодной водой каждое утро.","Слава богу, со зрением пока всё в порядке."],S7=["При ярком свете вашей лампы зрачки всегда сужаются в узкую черту. Отведите свет, слепит!","С детства такая особенность зрачков, врач говорил — светобоязнь.","В темноте они расширяются, а на солнце сужаются как у кошки. Это не преступление!"],H7=["От страха глаза на лоб лезут на вашем КПП! Никогда так не допрашивали!","Капли от глазного давления закапал{а|} перед границей, вот зрачки и широкие.","У нас в роду у всех глаза навыкате. Взгляните на фото в паспорте."],W7=["Такие зрачки у меня с рождения. В темноте ими видно шире, чем вашим фонариком.","От яркого света они всегда вытягиваются в черту. Это особенность, а не болезнь!","Это из-за случая в Гданьске, когда порт затопило прошлой весной. У многих после того наводнения зрачки стали плоские, как рыбина.","После тумана в Штеттине у половины улицы такие глаза. Зрачок лёг боком, и ничего не болит.","Я работал на маяке под Кёнигсбергом: годы смотреть на широкую воду — зрачки и вытянулись поперёк.","Врач в Линце сказал: плоские зрачки бывают от света ламп на ткацкой фабрике. У всех ткачей такие.","Мать говорила, в детстве я слишком долго смотрел в воду на рыб. Теперь зрачки как у рыбы, и что с того?"],_7=["Обычные человеческие глаза, офицер. Ничего особенного.","Смотрю прямо на вас. Зрачки реагируют на свет, как положено.","Разрез самый обыкновенный, не на что тут придираться."],E7=["Белки чистые. Записывайте результат и не ищите нарушения там, где их нет.","Обычный цвет белков. Ваш фонарь уже показал достаточно, дальше работайте по карточке.","Глаза не воспалены и не желтеют. Перейдите к следующему пункту осмотра."],T7=["Разрез прямой, человеческий. Не путайте внимательный взгляд с подозрительным.","Глаза обычной формы, только крупнее среднего. Это видно и без ваших догадок.","Зрачки круглые и стоят прямо. Проверяйте реакцию на свет, если вам нужен ещё один пункт."];function Q7(s){return s.map(e=>({agreesImmediately:!0,firstReply:e,reassurance:"",reassuredReply:"",reassured:!0,firmReply:"",persuadedByRules:!0}))}function R4({visitorId:s,isBloodshot:e,eyeShape:n,paused:c,disabled:i=!1,onReply:h,gender:u="m",kind:x,specialCharacter:p}){const m=x==="sclera",b=p==="goebbels",y=Q7(b?m?E7:T7:m?e?v7:g7:n==="slit"?S7:n==="wide"?H7:n==="horizontal"?W7:_7),M=b?m?"Что с белками глаз?":"Почему у вас такой разрез глаз?":m?e?"Почему у вас такие красные, воспалённые белки глаз?":"У вас подозрительно чистые, белые белки глаз.":n==="slit"?"Почему у вас узкие вертикальные зрачки?":n==="horizontal"?"Почему у вас горизонтальные зрачки?":"Что у вас с разрезом глаз?";return vl({visitorId:s,paused:c,subject:b?`goebbels-eye-${x}`:`eye-${x}`,profiles:y,prompt:M,insist:"",disabled:i,onReply:h,gender:u})}const A7=[{id:"second_jaw",label:"Вторая челюсть в глубине рта за зубами",minShift:5},{id:"fangs",label:"Удлинённые хищные клыки"},{id:"claws",label:"Чёрные звериные когти вместо ногтей"},{id:"webbing",label:"Перепонки между пальцами рук"},{id:"dirt_nails",label:"Трупная грязь под краями обычных ногтей"},{id:"slit_pupil",label:"Узкие вертикальные зрачки"},{id:"horizontal_pupil",label:"Горизонтальные зрачки, как у осьминога"},{id:"red_iris",label:"Кроваво-красная неестественная радужка"},{id:"yellow_sclera",label:"Желтоватые белки глаз"},{id:"scales",label:"Чешуйчатый узор и синеватый отлив кожи (проверить экзему)"},{id:"pearly_nails",label:"Перламутровый блеск ногтей, как у раковины"},{id:"shark_teeth",label:"Мелкие острые зубы в несколько рядов"},{id:"no_grey_55",label:"Возраст ≥ 55 лет без седины и морщин (Blutsauger)"},{id:"dry_breath",label:"Ледяной выдох без конденсата на стекле",minShift:4},{id:"droplets_breath",label:"Мокрый речной выдох с каплями на стекле",minShift:8},{id:"salt_breath",label:"Белёсый солёный налёт с кристаллами на стекле",minShift:4},{id:"smooth_hairless",label:"Абсолютно гладкая кожа без единого волоска",minShift:5},{id:"extra_finger",label:"Лишний палец на руке или перчатке (6 пальцев)",minShift:5},{id:"multi_pupil",label:"Несколько зрачков в одном глазу (поликория)",minShift:5},{id:"no_light_reaction",label:"Зрачок не реагирует на свет фонарика (неподвижен)",minShift:6},{id:"belladonna_drops",label:"Капли Belladonna Augentropfen обнаружены в сумке",minShift:7},{id:"green_teeth",label:"Зеленоватые зубы (речные мужчины, Nixen)",minShift:8},{id:"river_algae_nails",label:"Тина под ногтями (речные женщины, Nixen)",minShift:8}],N4=["Здравствуйте. Все документы у меня с собой.","Надеюсь, с документами всё в порядке.","Паспорт и разрешение при мне. Куда их положить?","Дорога была долгой. Хорошо, что очередь движется.","Пожалуйста, скажите, с чего начать проверку.","Мои родные ждут меня на той стороне.","Здравствуйте. Здесь проходят проверку документов?","Поезд скоро отправляется. Надеюсь, я успею.","Я приготовил{а|} бумаги заранее. Можете проверить.","Сегодня большая очередь. Я постараюсь вас не задерживать.","Буду ждать ваших указаний.","Надеюсь, ничего не забыл{а|}. Все бумаги в этой папке.","После дороги хочется поскорее добраться до места.","Если понадобится ещё какой-нибудь документ, скажите.","Спасибо. Я готов{а|} пройти обычную проверку.","Здравствуйте. Теперь моя очередь?","Вот бумаги. Угол помялся в дороге, но печать цела — я первым делом проверил{а|}.","Ну наконец-то. Я уже успел{а|} выучить все объявления на стене. Документы вот.","Только не говорите, что мне нужна ещё одна очередь. Я в предыдущей чуть не пустил{а|} корни.","Извините, папка всё время заедает. Когда не торопишься — открывается с первого раза.","Здравствуйте. Можно я сначала поставлю сумку? Она за дорогу словно вдвое потяжелела.","Я бумаги три раза проверил{а|}. Теперь боюсь, что в четвёртый раз обязательно что-нибудь найду.","Паспорт сверху, разрешение под ним. На станции посоветовали разложить заранее.","Простите, я не расслышал{а|}: к вам или в соседнее окно? Здесь все машут в разные стороны.","Если будет нужна подпись, покажите куда. Ручку я даже наготове держу.","Ваше окно видно издалека. Жаль, конец очереди оказался ещё дальше.","Я бы угостил{а|} вас яблоком, но оно осталось под чемоданом. Так что пока только документы.","Можно обойтись без спешки? Я когда тороплюсь, обязательно роняю нужную бумагу.","В вагоне кто-то всю дорогу спорил о расписании. Теперь я мечтаю о пяти минутах тишины.","Здравствуйте. Мне велели показать обе бумаги, а потом слушать вас. Вот обе.","Надеюсь, вы разбираете такой почерк. Я на фамилию писаря смотрю — и уже ничего не понимаю.","Я до самого окна думал{а|}, в каком кармане паспорт. Конечно, он оказался в том, который проверил{а|} последним.","Карта обещала короткую дорогу. Видимо, мы с картой по-разному понимаем слово «короткая».","Очередь хоть движется, и на том спасибо. Я уж думал{а|}, нас тут до следующего поезда оставят.","Держите. Бумаги сухие, хотя сумка по дороге познакомилась с каждой лужей.","Простите, я пока найду разрешение. Оно здесь... нет, это билет. Сейчас, одну секунду.","Сосед по вагону уверял, что проверка занимает минуту. Я на всякий случай приготовил{а|} две.","Мне главное — ничего не перепутать. Сначала паспорт, потом разрешение, верно?","Если я говорю невпопад, это от дороги. Сегодня даже станцию едва не проехал{а|}.","Здравствуйте. Все нужные печати на месте. По крайней мере, в конторе так обещали.","Скажите, после вашего окна уже можно идти дальше? Очень хочется наконец перестать стоять.","Папка старая, зато надёжная. Через сколько контор со мной прошла — не сосчитать.","Я себе всё на бумажке записал{а|}, чтобы не растеряться. А бумажку, кажется, положил{а|} слишком надёжно.","Вот паспорт. Фотография, конечно, не лучшая, но переснимать меня в конторе не стали.","Можно чуть ближе подать бумаги? Вечно кажется, что я кладу их не туда.","В очереди столько советчиков, что я уже не знаю, кого слушать. Давайте лучше вы скажете.","Если всё в порядке, подскажите, где здесь выход. Я в этих коридорах уже один раз заблудил{ся|ась}.","В конторе сказали: «Берегите печати». Теперь папку держу осторожнее, чем чемодан.","Наконец-то добрались до проверки. Я уже успел{а|} пожалеть, что взял{а|} такой большой багаж.","Здравствуйте. Надеюсь, у вас день спокойнее, чем был у меня в дороге.","Держите документы. И спасибо, что очередь идёт по порядку — на станции с этим было хуже.","Вот бумаги. Я сейчас замолчу, а то от волнения расскажу вам всю дорогу по минутам."];function R7(s){let e=(s^1095914057)>>>0;return e=Math.imul(e^e>>>16,2146121005),e=Math.imul(e^e>>>15,2221713035),N4[((e^e>>>16)>>>0)%N4.length]}const N7=new Set([141504916,716680131,859496097,955603684,1288900097,1570268815,1590347772,1790058696,1901293876,1939943688,2186686007,2351485426,2368718941,2646300291,3015266704,3027797828,3213974211,3403418572,3561490873,3695459552,3828602865,4185536356,4201289149,4278337312]);function Z7(s){let e=2166136261;for(const n of s)e=Math.imul(e^n.codePointAt(0),16777619);return e>>>0}function O7(s,e){if(!s||s.text===e||s.serial!==1&&!N7.has(Z7(s.text)))return s;const n=Array.from(s.text).length,c=Array.from(e).length,i=n===0?0:Math.round(Math.min(1,s.revealed/n)*c);return{...s,text:e,revealed:i}}const D7=.5,z7=.5,B7=["werewolf","ghoul","mermaid"];function tn(s,e){let n=(s^e)>>>0;return n=Math.imul(n^n>>>16,2146121005),n=Math.imul(n^n>>>15,2221713035),((n^n>>>16)>>>0)/4294967296}function G7(s,e,n){const c=n>=7&&B7.includes(e)&&tn(s,1163478327)<D7,i=c&&tn(s,1111837751)<z7;return{eyesDisguised:c,hasBelladonna:i}}const Pc={ticket:{title:"Железнодорожный билет",note:"Помятый билет с отметкой станции.",kind:"paper"},letters:{title:"Письма в конвертах",note:"Личные письма, перетянутые бечёвкой.",kind:"paper"},notebook:{title:"Карманная записная книжка",note:"Адреса, расходы и заметки в дороге.",kind:"paper"},comb:{title:"Гребень",note:"Обычный деревянный гребень.",kind:"comb"},handkerchief:{title:"Носовой платок",note:"Сложенный тканевый платок.",kind:"cloth"},bread:{title:"Сверток с едой",note:"Дорожный перекус в бумаге.",kind:"parcel"},belladonna:{title:"Капли «Belladonna»",note:"На немецкой этикетке: «Belladonna · Augentropfen». Флакон глазных капель.",kind:"drops"},partyBadge:{title:"Партийный значок",note:"Тяжёлый партийный знак на булавке, отполированный до блеска.",kind:"paper"},partyDirective:{title:"Служебная партийная записка",note:"Папка с распоряжениями и отметками канцелярии.",kind:"paper"},partyArmband:{title:"Партийная повязка",note:"Сложенная красная повязка с официальной символикой.",kind:"cloth"},partyCards:{title:"Партийные удостоверения",note:"Несколько карточек с печатями и фамилиями сопровождающих.",kind:"paper"}},F1=["ticket","letters","notebook","comb","handkerchief","bread"];function U7(s,e){const n=Math.floor(tn(s,1111574327)*F1.length),c=[F1[n],F1[(n+2)%F1.length],F1[(n+4)%F1.length]];return e?[...c,"belladonna"]:c}const Y7=[s=>`О господи, простите меня! У меня руки трясутся, трое суток без сна в теплушке! Я до войны десять лет {был|была} ${s.formerRole}, вот со страху язык и ляпнул! Сейчас я ${s.currentRole}!`,s=>`Боже правый, не смотрите на меня так строго, офицер! Старая привычка проклятая! Двадцать лет изо дня в день {работал|работала} ${s.formerRole}, а теперь перевели... Я еду как ${s.currentRole}, вот и всё!`,s=>`Постойте, нет-нет! Это у меня от страха рассудок помутился! Брата ночью увели жандармы, он как раз ${s.formerRole}, вот и вертится в голове! А я сам{а|} ${s.currentRole}!`,s=>`Ай, проклятый склероз и эта сирена проклятая! Назвал{а|} специальность по диплому, а ведь на заводе числюсь как ${s.currentRole}! Не губите из-за дурацкого слова!`,s=>`Пока в очереди стоял{а|}, думал{а|}: спросят про прошлое — скажу ${s.formerRole}... А вы про настоящее спросили! Я ${s.currentRole}, вот куда меня направили.`,s=>`Пощадите, господин клерк! У меня в голове звон от взрывов на станции, я еле на ногах стою! Смешалось всё! Я еду как ${s.currentRole}, честное слово!`,s=>`Ох, дурная моя голова! Я же на курсах переподготовки полгода {горбатился|горбатилась}, чтобы стать ${s.currentRole}, а по инерции старую работу выпалил{а|}!`,s=>`Господи помилуй, да я просто до смерти перепуган{а|} вашим КПП! Я ${s.currentRole}! Спросите хоть про инструменты — всё до винтика расскажу!`,s=>`Это из-за старой трудовой книжки! Там первая запись — ${s.formerJob}, а новое назначение — ${s.currentJob}! Не казните за оговорку!`,s=>`Тише, ради бога, не кричите на меня, у меня сердце больное! Я просто растерял{ся|ась}! Работаю ${s.currentRole}!`,s=>`Дома вся родня меня до сих пор кличет «наш ${s.formerRole}», вот язык и подвёл перед строгим начальством! Но на службу еду как ${s.currentJob}!`,s=>`Я не отказываюсь от прежней профессии, но вы спросили, кем я еду сейчас! Новое назначение — ${s.currentJob}, а ${s.formerRole} я был{а|} раньше.`,s=>`Виноват{а|}, слишком быстро ответил{а|}. После эвакуации всё смешалось. Нынешняя должность — ${s.currentJob}, вот что важно.`,s=>`Спросите ещё раз спокойно: кем я направлен{а|}? ${s.currentJob}. Я назвал{а|} ${s.formerRole}, потому что так привык{ла|} говорить.`,s=>`Неужели одно слово перечеркнёт десять лет честной службы? Я переучил{ся|ась} и теперь работаю как ${s.currentRole}.`,s=>`В дороге все обсуждали прошлые работы, вот я и повторил{а|} за соседом. Моё настоящее место — ${s.currentJob}, не отправляйте меня обратно из-за оговорки.`,s=>`Голова забита расписаниями и адресами, потому что я еду впервые. Простите оговорку: теперь я ${s.currentRole}, хотя прежде был{а|} ${s.formerRole}.`,s=>`Я {согласен|согласна}, ответ прозвучал неясно. Нынешняя должность — ${s.currentJob}; прежняя — ${s.formerJob}.`],q7=[s=>`Похоже, в конторе опять напутали. Я еду работать ${s.currentRole}, а что они там вписали в старую строку — откуда мне знать?`,s=>`Я забирал{а|} бумаги в спешке и не заметил{а|} эту запись. Моя работа — ${s.currentRole}, не ${s.formerRole}.`,()=>"Визу оформляли после эвакуации, там была ужасная суматоха. Похоже, мне вписали профессию из чужого бланка.",s=>`Да, в одной бумаге стоит ${s.currentJob}, а в другой почему-то ${s.formerJob}. Я сам{а|} только сейчас это увидел{а|}.`,s=>`Работодатель ждёт меня как ${s.currentRole}. Откуда в бумагах взялась другая профессия, я не знаю.`,()=>"Я не пытаюсь вас запутать. В одной бумаге ошибка — вот и вся история.",s=>`Мне выдали этот лист в комендатуре. Я сказал{а|}, что еду как ${s.currentRole}, но в графу, видимо, внесли не то.`,s=>`Похоже, при переписывании документов взяли старую запись — ${s.formerJob}. Сейчас я работаю как ${s.currentRole}.`,()=>"Я {должен был|должна была} проверить всё ещё в конторе. Сам{а|} виноват{а|}, что не заметил{а|} эту строку.",s=>`Возможно, у меня на руках старый вариант визы. Мой работодатель ждёт ${s.currentRole}.`,()=>"Не спорю, документы выглядят плохо. Я получил{а|} их перед самым поездом и не успел{а|} попросить исправить запись.",s=>`В конторе, должно быть, перепутали две папки. Я еду как ${s.currentRole}, а не как человек из старой строки.`,s=>`Проверьте дату назначения. Меня направили как ${s.currentRole}, а ${s.formerJob} осталось от старой записи.`,s=>`Это неприятно. Я еду работать ${s.currentRole}; почему в бумагах осталось другое слово, сам{а|} не понимаю.`,s=>`В конторе перепутали папки. Я не скрываю свою работу: я ${s.currentRole}.`,s=>`Проверьте дату назначения. Меня направили как ${s.currentRole}, а старая запись почему-то осталась.`,()=>"Я не заметил{а|} ошибку, когда подписывал{а|} бумаги. Понимаю, что теперь вам трудно мне поверить.",s=>`Да, это неприятно. Я еду как ${s.currentRole}, а вторая запись явно осталась от старого дела.`,s=>`Похоже, в конторе перепутали записи. Я еду как ${s.currentRole}; пусть сами разбираются, кто это оформлял.`],V7=[s=>`Паспорта нет — дома остался. Я работаю ${s.currentRole}, а дальше уж сами смотрите, что у меня за виза.`,s=>`У меня только виза. Я еду как ${s.currentRole}; паспорт не взял{а|}, торопился{ась}.`,s=>`Паспорт я не взял{а|}. Не помню, что там было записано, но работаю я ${s.currentRole}.`,()=>"Визу выдали перед самым отъездом, а паспорт остался дома. Не успел{а|} собрать всё как следует."],X7=[s=>`Виза осталась в конторе. В паспорте написано, что я ${s.currentRole}; вот и всё, что могу показать.`,()=>"Я не успел{а|} забрать рабочую визу. Паспорт вот, а второй бумаги нет.",s=>`Меня взяли как ${s.currentRole}, но визу должны были подвезти к поезду. Не подвезли.`,()=>"Без визы я сам{а|} понимаю, что выгляжу подозрительно. Но я выехал{а|} в спешке и забрать её не успел{а|}."],F7=[s=>`(Нервно облизывает пересохшие губы). Виза… виза получена легально! Какая разница, ${s.currentJob} или нет?! Вы не имеете права задерживать!`,()=>"(Лицо перекашивается от скрытой злобы). Слишком много вопросов для мелкого клерка… Пропусти по-хорошему, пока поезд не ушёл!",()=>"(В панике хватается за воротник). Не смотрите туда! Мне клялись, что эта бумага пройдёт любой пост! Я просто пассажир!",()=>"(Дрожащий шёпот переходит в утробное рычание). Замолчи… Просто поставь штамп и открой калитку…",()=>"(Судорожно пятится назад). Я… меня подставили! Это не мой чемодан и не мои документы!",()=>"(Стеклянный неподвижный взгляд, ледяной тон). Буквы на этой бумаге больше ничего не значат. Поставьте штамп.",s=>`(Слишком быстро улыбается). ${s.currentJob}? Разумеется. Просто бумага сама себе противоречит. Пустите меня, и никто не заметит мелкой ошибки.`,()=>"(Пальцы замирают на краю паспорта). Бумаги лучше не перелистывать. Поставьте штамп.",s=>`(Сухой смешок). Вы хотите профессию или формальности? Написано ${s.currentJob}, написано ${s.formerJob} — какая строка откроет ворота быстрее?`,()=>"(Отводит взгляд). Я запомнил{а|} чужое имя и чужую должность. Иногда это безопаснее, чем назвать свою.",s=>`(Голос становится ровным и пустым). ${s.currentJob} — это имя на странице. Имя на другой странице — ${s.formerJob}. Оба ответа правильны, если вы умеете читать.`,()=>"(Рывком закрывает папку). Данные совпадают ровно настолько, насколько нужно для прохода. Не ищите лишнего, клерк.",s=>`(Смотрит на печать, не моргая). ${s.currentJob}... да, это подходит. А если вы видите ${s.formerJob}, значит, бумага уже начала лгать.`],K7=19;function J7(s,e,n){const c=s==="slip"?Y7:s==="wrong_docs"?e.missingDocument==="passport"?V7:e.missingDocument==="visa"?X7:q7:F7,i=u=>/\(([^)]+)\)/.exec(u)?.[1]??u,h={...e,currentJob:i(e.currentJob),formerJob:i(e.formerJob)};return Ml(e.gender,c[Math.abs(n)%c.length](h))}const I7=[...yo.filter(s=>s!=="cloth-1938-uberfrau-unifor